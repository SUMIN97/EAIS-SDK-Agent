# 이 파일을 복사해 .env 로 이름을 바꾸고, 발급받은 OPENAI_API_KEY 를 넣습니다.
#
#   copy .env.example .env
#
# 키가 없어도 앱은 돌아갑니다 (LLM 없이 문서 기본값·규칙으로 질문).
# .env 는 여러분 PC 에만 있습니다. 키를 다른 곳에 붙여넣지 마세요.

OPENAI_API_KEY=여기에_키를_붙여넣으세요

# SDK MCP 서버 주소와 도구 이름. 실제 값을 받으면 바꿉니다 (요청 본문·curl 에만 쓰이고, 이 앱이 직접 보내지 않습니다).
SDK_MCP_URL=http://127.0.0.1:8790/mcp
SDK_MCP_TOOL=eais_run_pipeline
