{
  "meta": {
    "sdk": "Exynos AI Studio (EAIS) SDK 3.0",
    "source": "https://soc-developer.semiconductor.samsung.com/global/development/ai-studio/document/documentation/sdk-3.0",
    "fetched": "2026-09-28",
    "note": "sdk_docs/raw/*.md 원문에서 사용자가 골라야 하는 파라미터만 뽑아 구조화했다. 순서가 곧 기본 질문 순서다.",
    "docs": {
      "eais-user-guide": "EAIS 사용자 가이드",
      "whats-new": "SDK 3.0 업데이트 안내",
      "debug-guide": "디버그 가이드",
      "compile-guide": "컴파일 가이드",
      "profiling-guide": "프로파일링 가이드"
    }
  },
  "files": {
    "model_yaml": "<workspace>/<model_name>.yaml",
    "dbgen_spec": "Config/DATA/dbgen_spec.yaml",
    "compiler_tuning": "Config/compiler_tuning_mode_config.yaml",
    "profiler_advanced": "Config/profiler_advanced_config.yaml",
    "debug_yaml": "Config/debug.yaml",
    "pipeline": "(CLI 실행 계획)"
  },
  "stages": [
    {
      "id": "init", "title": "워크스페이스 초기화", "cmd": "eais init --w <workspace>", "need": "필수",
      "desc": "워크스페이스(폴더명 = 모델 파일명)에 <model_name>.yaml 과 Config/ 설정 파일을 만든다. 이미 init 된 곳에서 다시 실행하면 yaml 을 덮어쓴다.",
      "outputs": "<model_name>.yaml · Config/ · Config/DATA/dbgen_spec.yaml (랜덤 기본값)",
      "doc": "eais-user-guide", "section_title": "Step 1: init",
      "prefixes": ["workspace.", "general."]
    },
    {
      "id": "generation", "title": "캘리브레이션 데이터 생성", "cmd": "eais generation --w <workspace>", "need": "필수",
      "desc": "Config/DATA/dbgen_spec.yaml 을 읽어 캘리브레이션용 npy 를 만든다. dbgen_spec.yaml 은 반드시 실제 모델 입력 개수·shape 에 맞게 편집해야 한다.",
      "outputs": "Config/DATA/input_data/<input_name>/database_*.npy · database.txt · input_folder_mapping.json",
      "doc": "eais-user-guide", "section_title": "Step 2: generation",
      "prefixes": ["dbgen."]
    },
    {
      "id": "conversion", "title": "모델 변환", "cmd": "eais conversion --w <workspace>", "need": "필수",
      "desc": "EHT(converter → optimizer → quantizer, 단계마다 ModelValidator) → ELT(specifier) 순서로 ONNX/TFLite 를 타겟 SoC 용 HW SNC 로 변환한다. generation 이 먼저 끝나 있어야 한다.",
      "outputs": "Converter_result/HW_<model>_<version>.snc · NPU_<model>/testvector/ · Debug_result/pipeline_artifacts.json",
      "doc": "eais-user-guide", "section_title": "Step 3: conversion",
      "prefixes": ["converter.", "conversion."]
    },
    {
      "id": "debug", "title": "정확도 검증 · 시각화", "cmd": "eais debug --w <workspace>", "need": "선택",
      "desc": "conversion 각 모듈 산출물을 원본과 비교해 SNR/PSNR/COSSIM 을 계산하거나 그래프를 브라우저에서 시각화한다. pipeline_artifacts.json 이 필요하다.",
      "outputs": "Debug_result/accuracy_validation_results/accuracy_comparison.xlsx · debug_report.json",
      "doc": "debug-guide", "section_title": "옵션 및 파라미터",
      "prefixes": ["debug."]
    },
    {
      "id": "compile", "title": "NNC 컴파일", "cmd": "eais compile --w <workspace>", "need": "권장",
      "desc": "Converter_result/HW_*.snc 를 NPU 에서 실행 가능한 .nnc 로 컴파일한다. 기기에서 돌리려면 필요하다.",
      "outputs": "Compiler_result/<model>.nnc · NNCInfo.csv · nncontainer-gen.txt",
      "doc": "compile-guide", "section_title": "옵션 정리",
      "prefixes": ["compiler.", "compiler_tuning."]
    },
    {
      "id": "profiling", "title": "실기기 성능 측정", "cmd": "eais profiling --w <workspace>", "need": "선택",
      "desc": "실제 Exynos 기기에서 .nnc 의 추론 시간·메모리를 측정한다. Compiler_result 와 Enn test app 이 설치된 기기가 필요하다.",
      "outputs": "Profiler_result/VisualProfiler/Annotation/NPU_STM_summary.json (Perfetto UI 로 확인)",
      "doc": "profiling-guide", "section_title": "옵션 정리",
      "prefixes": ["profiler.", "profiler_adv."]
    }
  ],
  "params": [
    {
      "id": "pipeline.steps", "file": "pipeline", "key": "steps", "label": "실행할 단계",
      "type": "multi", "level": "basic",
      "default": ["init", "generation", "conversion", "compile"],
      "options": [
        {"value": "init", "desc": "워크스페이스 초기화 — <model_name>.yaml, Config/ 생성"},
        {"value": "generation", "desc": "dbgen_spec.yaml 기반 캘리브레이션 npy 데이터 생성"},
        {"value": "conversion", "desc": "ONNX/TFLite → HW SNC 변환 (EHT: converter·optimizer·quantizer, ELT: specifier)"},
        {"value": "debug", "desc": "conversion 단계별 정확도(SNR/PSNR/COSSIM) 비교·시각화"},
        {"value": "compile", "desc": "HW SNC → NPU 실행용 .nnc 컴파일"},
        {"value": "profiling", "desc": "실기기에서 추론 시간·메모리 측정 (기기 연결 필요)"}
      ],
      "desc": "eais CLI 파이프라인 중 SDK 에서 실행할 단계. conversion 전에는 generation 이, compile 전에는 conversion 이 끝나 있어야 한다.",
      "doc": "eais-user-guide", "section_title": "1. CLI 파이프라인"
    },
    {
      "id": "workspace.path", "file": "pipeline", "key": "workspace", "label": "워크스페이스 경로",
      "type": "str", "level": "basic", "default": "/home/user/eais-projects/{model_name}",
      "options": [],
      "desc": "SDK 쪽 워크스페이스 폴더. 폴더 이름과 모델 파일 이름(확장자 제외)이 반드시 같아야 한다. 다르면 'Error code: 102 workspace error'.",
      "doc": "eais-user-guide", "section_title": "2. 워크스페이스 구조"
    },
    {
      "id": "general.device", "file": "model_yaml", "section": "general", "key": "device", "label": "타겟 SoC (device)",
      "type": "enum", "level": "basic", "default": "Gen-9",
      "options": [
        {"value": "Gen-9", "desc": "Ulysses (S5E9975)"},
        {"value": "Gen-8", "desc": "Thetis (S5E9965)"},
        {"value": "Gen-7", "desc": "Solomon (S5E9955), Terra (S5E8865), Vesper (S5E8875)"},
        {"value": "Gen-6", "desc": "Root (S5E9945)"},
        {"value": "Gen-5", "desc": "Quadra (S5E9945), Santa (S5E8855), Rose (S5E8845), Kitt2 (S5AV920)"},
        {"value": "Gen-4", "desc": "Pamir (S5E9925)"},
        {"value": "Gen-3", "desc": "Olympus (S5E9840), Quartz (S5E8835)"},
        {"value": "Gen-2", "desc": "2020AP (S5E9830)"}
      ],
      "desc": "모델이 실행될 SoC. 실제 타겟 하드웨어와 다르면 compile/profiling 결과가 무효하다. SDK 3.0 기본값은 Gen-9 (2.5 는 Gen-8).",
      "doc": "eais-user-guide", "section_title": "general 섹션"
    },
    {
      "id": "converter.skip_quantization", "file": "model_yaml", "section": "converter", "key": "skip_quantization", "label": "양자화 건너뛰기",
      "type": "bool", "level": "basic", "default": false,
      "when": [["pipeline.steps", "has", "conversion"]],
      "options": [
        {"value": true, "desc": "입력이 이미 양자화된 것으로 보고 specifier 로 바로 진행"},
        {"value": false, "desc": "캘리브레이션 데이터로 양자화 수행 (일반적인 경우)"}
      ],
      "desc": "이미 양자화된 모델(QDQ 노드, int8 텐서 등)이면 true.",
      "doc": "eais-user-guide", "section_title": "converter 섹션"
    },
    {
      "id": "converter.precision", "file": "model_yaml", "section": "converter", "key": "precision", "label": "양자화 정밀도 (precision)",
      "type": "enum", "level": "basic", "default": "A8W8",
      "when": [["pipeline.steps", "has", "conversion"], ["converter.skip_quantization", "!=", true]],
      "options": [
        {"value": "A8W8", "desc": "8-bit activation, 8-bit weight — 가장 일반적. 권장 SNR 20dB 이상"},
        {"value": "A16W8", "desc": "16-bit activation, 8-bit weight — 권장 SNR 30dB 이상"},
        {"value": "A16W4", "desc": "16-bit activation, 4-bit weight"},
        {"value": "A8W4", "desc": "8-bit activation, 4-bit weight"},
        {"value": "FP16", "desc": "16-bit 부동소수점, 정수 양자화 없음 — 권장 SNR 35dB 이상"},
        {"value": "MXINT8", "desc": "Microscaling INT8 (SDK 3.0 신규)"}
      ],
      "desc": "양자화 정밀도 프로파일. 정확도가 부족하면 A8W8 → A16W8 → FP16 순으로 올린다.",
      "doc": "eais-user-guide", "section_title": "converter 섹션 › precision"
    },
    {
      "id": "dbgen.{input}.random", "file": "dbgen_spec", "key": "random", "per_input": true, "label": "[{input}] 캘리브레이션 데이터 종류",
      "type": "bool", "level": "basic", "default": true,
      "when": [["pipeline.steps", "has", "generation"]],
      "options": [
        {"value": false, "desc": "실제 데이터셋 사용 (권장) — path/ext 지정 필요"},
        {"value": true, "desc": "랜덤 텐서 생성 (빠른 테스트용). float 는 [0,1) 균등분포 — 변환 품질 저하 가능"}
      ],
      "desc": "eais init 기본값은 랜덤이지만, 그대로 쓰면 변환 품질이 떨어질 수 있어 실제 대표 데이터셋을 권장한다.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.path", "file": "dbgen_spec", "key": "path", "per_input": true, "label": "[{input}] 데이터셋 폴더 경로",
      "type": "str", "level": "basic", "default": "./dataset",
      "when": [["pipeline.steps", "has", "generation"], ["dbgen.{input}.random", "==", false]],
      "options": [
        {"value": "./dataset", "desc": "<workspace>/dataset (워크스페이스 기준 상대경로, 권장)"},
        {"value": "./dataset/{input}", "desc": "입력이 여러 개일 때 입력별 하위 폴더"}
      ],
      "desc": "상대경로는 워크스페이스 기준으로 해석된다. 워크스페이스 밖이면 절대경로를 쓴다.",
      "doc": "eais-user-guide", "section_title": "path 경로 주의사항"
    },
    {
      "id": "dbgen.{input}.ext", "file": "dbgen_spec", "key": "ext", "per_input": true, "label": "[{input}] 데이터 파일 확장자",
      "type": "enum", "level": "basic", "default": "raw",
      "when": [["pipeline.steps", "has", "generation"], ["dbgen.{input}.random", "==", false]],
      "options": [
        {"value": "raw", "desc": "바이너리 텐서. 파일 크기 = dtype 크기 × shape 원소 수 여야 함"},
        {"value": "bin", "desc": "바이너리 텐서 (raw 와 동일 규칙)"},
        {"value": "jpg", "desc": "JPEG 이미지"},
        {"value": "jpeg", "desc": "JPEG 이미지"},
        {"value": "png", "desc": "PNG 이미지"},
        {"value": "bmp", "desc": "BMP 이미지"}
      ],
      "desc": "데이터셋 파일 확장자.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.shape", "file": "dbgen_spec", "key": "shape", "per_input": true, "label": "[{input}] 입력 shape",
      "type": "shape", "level": "auto", "default": null,
      "when": [["pipeline.steps", "has", "generation"]],
      "options": [],
      "desc": "모델 입력 텐서 shape. ext 와 관계없이 항상 정의. 모델에서 읽은 값을 쓰며, 동적 차원(batch 등)이 있으면 반드시 정수로 지정해야 한다.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.order", "file": "dbgen_spec", "key": "order", "per_input": true, "label": "[{input}] 차원 순서 (order)",
      "type": "enum", "level": "basic", "default": "nchw",
      "when": [["pipeline.steps", "has", "generation"]],
      "options": [
        {"value": "nchw", "desc": "(batch, channel, height, width) — PyTorch 기본"},
        {"value": "nhwc", "desc": "(batch, height, width, channel) — TensorFlow/OpenCV 기본"},
        {"value": "chw", "desc": "(channel, height, width)"},
        {"value": "hwc", "desc": "(height, width, channel)"}
      ],
      "desc": "입력 데이터의 차원 순서.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.dtype", "file": "dbgen_spec", "key": "dtype", "per_input": true, "label": "[{input}] 데이터 타입",
      "type": "enum", "level": "auto", "default": "float32",
      "when": [["pipeline.steps", "has", "generation"]],
      "options": [
        {"value": "float32", "desc": ""}, {"value": "float16", "desc": ""}, {"value": "float64", "desc": ""},
        {"value": "uint8", "desc": ""}, {"value": "int8", "desc": ""}, {"value": "uint16", "desc": ""},
        {"value": "int16", "desc": ""}, {"value": "int32", "desc": ""}, {"value": "int64", "desc": ""},
        {"value": "bool", "desc": ""}
      ],
      "desc": "데이터 타입. 모델 입력 dtype 과 맞춘다.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.mean", "file": "dbgen_spec", "key": "mean", "per_input": true, "label": "[{input}] 전처리 mean",
      "type": "list", "level": "basic", "default": [0],
      "when": [["pipeline.steps", "has", "generation"], ["dbgen.{input}.random", "==", false]],
      "options": [
        {"value": [0], "desc": "평균 감산 없음 (데이터가 이미 전처리된 경우)"},
        {"value": [0.485, 0.456, 0.406], "desc": "ImageNet 평균 (scale 255 로 [0,1] 정규화 후 적용하는 모델)"},
        {"value": [127.5], "desc": "[-1, 1] 정규화 모델 (scale 127.5 와 함께)"}
      ],
      "desc": "output = (raw - mean) * scale. 스칼라 또는 채널 수만큼의 리스트.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "dbgen.{input}.scale", "file": "dbgen_spec", "key": "scale", "per_input": true, "label": "[{input}] 전처리 scale",
      "type": "list", "level": "basic", "default": [1],
      "when": [["pipeline.steps", "has", "generation"], ["dbgen.{input}.random", "==", false]],
      "options": [
        {"value": [1], "desc": "스케일 없음 (raw 그대로)"},
        {"value": [255], "desc": "255 로 나눠 [0, 1] 정규화 (scale > 1 이면 내부적으로 1/scale)"},
        {"value": [127.5], "desc": "127.5 로 나눔 (mean 127.5 와 함께 [-1, 1])"}
      ],
      "desc": "scale > 1 이면 내부적으로 역수(1/scale)로 변환된다.",
      "doc": "eais-user-guide", "section_title": "dbgen_spec.yaml 작성 방법"
    },
    {
      "id": "converter.calibration_mode", "file": "model_yaml", "section": "converter", "key": "calibration_mode", "label": "캘리브레이션 모드",
      "type": "enum", "level": "basic", "default": "default",
      "when": [["pipeline.steps", "has", "conversion"], ["converter.skip_quantization", "!=", true], ["converter.precision", "!=", "FP16"]],
      "options": [
        {"value": "default", "desc": "calibration_method 에 지정한 방법을 전체 데이터에 적용"},
        {"value": "auto", "desc": "weight/activation 유형별 최적 캘리브레이션 방법을 자동 탐색"}
      ],
      "desc": "캘리브레이션 모드.",
      "doc": "eais-user-guide", "section_title": "converter 섹션 › calibration_mode"
    },
    {
      "id": "converter.calibration_method", "file": "model_yaml", "section": "converter", "key": "calibration_method", "label": "캘리브레이션 알고리즘",
      "type": "enum", "level": "basic", "default": "minmax",
      "when": [["pipeline.steps", "has", "conversion"], ["converter.skip_quantization", "!=", true], ["converter.precision", "!=", "FP16"], ["converter.calibration_mode", "!=", "auto"]],
      "options": [
        {"value": "minmax", "desc": "텐서 min/max 로 scale 산출. 가장 빠름"},
        {"value": "percentile", "desc": "백분위수 기반 아웃라이어 클리핑. heavy-tailed 분포에 유용"},
        {"value": "histogram_enhanced", "desc": "AIMET tf-enhanced, KL divergence 최소화. 가장 정확하나 느림"}
      ],
      "desc": "PTQ scale/offset 추정 알고리즘. SNR 이 낮으면 minmax → percentile → histogram_enhanced 순으로 시도.",
      "doc": "eais-user-guide", "section_title": "converter 섹션 › calibration_method"
    },
    {
      "id": "converter.use_cuda", "file": "model_yaml", "section": "converter", "key": "use_cuda", "label": "GPU(CUDA) 사용",
      "type": "bool", "level": "basic", "default": false,
      "when": [["pipeline.steps", "has", "conversion"], ["converter.skip_quantization", "!=", true]],
      "options": [
        {"value": true, "desc": "GPU 에서 캘리브레이션 (빠름, CUDA 장치 필요)"},
        {"value": false, "desc": "CPU 에서 캘리브레이션"}
      ],
      "desc": "변환·양자화 시 CUDA 사용 여부. SDK 서버에 GPU 가 있을 때만 true.",
      "doc": "eais-user-guide", "section_title": "converter 섹션 › use_cuda"
    },
    {
      "id": "converter.input_dtype", "file": "model_yaml", "section": "converter", "key": "input_dtype", "label": "양자화 모델 입력 dtype",
      "type": "enum", "level": "basic", "default": "float32",
      "when": [["pipeline.steps", "has", "conversion"]],
      "options": [
        {"value": "float32", "desc": "32-bit float (기본)"}, {"value": "float16", "desc": "16-bit float"},
        {"value": "uint8", "desc": "unsigned 8-bit"}, {"value": "int8", "desc": "signed 8-bit"},
        {"value": "uint16", "desc": "unsigned 16-bit"}, {"value": "int16", "desc": "signed 16-bit"},
        {"value": "none", "desc": "모델 원본 dtype 유지"}
      ],
      "desc": "NPU 모델 입력 텐서 dtype 강제 지정. 앱에서 uint8 이미지를 바로 넣으려면 uint8.",
      "doc": "eais-user-guide", "section_title": "converter 섹션 › input_dtype / output_dtype"
    },
    {
      "id": "converter.output_dtype", "file": "model_yaml", "section": "converter", "key": "output_dtype", "label": "양자화 모델 출력 dtype",
      "type": "enum", "level": "basic", "default": "float32",
